---
/** Field-log entry: title + mono notes (one line per array item). A line may be a link. */
type Line = string | { text: string; href: string };
interface Props { title: string; lines: Line[]; class?: string; style?: string }
const { title, lines, class: cls = '', style } = Astro.props;
---
<div class:list={['log', cls]} style={style}>
  <p class="label">{title}</p>
  <p class="mono-sm justify">
    {lines.map((l, i) => <>{typeof l === 'string' ? l : <a href={l.href}>{l.text}</a>}{i < lines.length - 1 && <br />}</>)}
  </p>
</div>

<style>
  .log { display: flex; flex-direction: column; gap: 20px; }
  :global(.inner) .log { gap: 14px; }
  a { transition: color .3s; }
  a:hover { color: var(--white); }
</style>
