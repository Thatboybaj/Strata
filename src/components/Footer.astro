---
import { Image } from 'astro:assets';
import Rails from './Rails.astro';
import peaks from '../assets/images/footer-peaks.webp';
import mountain from '../assets/images/footer-mountain.webp';
import foreground from '../assets/images/footer-foreground.webp';

const groups = [
  { label: 'Studio:', items: [
    { text: 'Home', href: '/' }, { text: 'About', href: '/about' },
    { text: 'Services', href: '/services' }, { text: 'Expeditions', href: '/expeditions' } ] },
  { label: 'Field Offices', items: [
    { text: 'Oslo', href: '/about#offices' }, { text: 'Reykjavík', href: '/about#offices' },
    { text: 'Vancouver', href: '/about#offices' }, { text: 'Santiago', href: '/about#offices' } ] },
  { label: 'Legal:', items: [ { text: 'Privacy policy', href: '/privacy' }, { text: 'Terms', href: '/privacy' } ] },
  { label: 'Contact:', items: [
    { text: 'Linkedin', href: 'https://www.linkedin.com' }, { text: 'Instagram', href: 'https://www.instagram.com' },
    { text: '+47 00 000 0000', href: 'tel:+4700000000' }, { text: 'contact@strata.studio', href: 'mailto:contact@strata.studio' } ] },
];
---
<footer class="sec footer">
  <p class="wordmark" aria-hidden="true">STRATA</p>
  <Rails />
  <Image class="layer peaks" src={peaks} alt="" widths={[1373, 2746]} sizes="95vw" />
  <Image class="layer mountain" src={mountain} alt="" widths={[1439, 2878]} sizes="100vw" />
  <Image class="layer foreground" src={foreground} alt="" widths={[1602, 3204]} sizes="111vw" />

  <nav class="links col-b" aria-label="Footer">
    {groups.map((g) => (
      <div class="group">
        <p class="glabel">{g.label}</p>
        <ul>
          {g.items.map((it) => <li><a href={it.href}>{it.text}</a></li>)}
        </ul>
      </div>
    ))}
  </nav>

  <p class="display tagline col-ab">Architecture for the places that <em>shape</em> us before we <em>shape</em> them.</p>
  <p class="fquote col-c">"The Earth doesn't need our architecture. It asks for our understanding."</p>
  <p class="mono copy col-ab">© 2026 STRATA&nbsp;&nbsp;All Rights Reserved.</p>
  <p class="mono season col-c">FIELD SEASON 2026</p>
</footer>

<style>
  .footer { height: 1024px; }
  .wordmark {
    position: absolute; z-index: 0;
    left: calc(50% - 693px); top: 307px;
    font-weight: 600; font-size: 400px; line-height: 0.9; letter-spacing: -16px;
    white-space: nowrap; opacity: 0.2;
  }
  .footer :global(.layer) { height: auto; }
  .footer :global(.peaks) { left: calc(8.333% - 2px); top: 303px; width: 1373px; height: 614px; }
  .footer :global(.mountain) { left: -110px; top: 388px; width: 1439px; height: 811px; }
  .footer :global(.foreground) { left: -162px; top: 499px; width: 1602px; height: 782px; }

  .links { margin-top: 120px; display: flex; justify-content: space-between; }
  .group { display: flex; flex-direction: column; gap: 20px; min-width: 80px; }
  .glabel, .links a { font-size: 16px; line-height: 1.3; letter-spacing: -0.64px; white-space: nowrap; }
  .glabel { color: var(--white-70); }
  .links ul { display: flex; flex-direction: column; gap: 10px; }
  .links li { padding: 2px; display: flex; }
  .links a { display: inline-block; transition: opacity .3s; }
  .links a:hover { opacity: .6; }

  .tagline { margin-top: 440px; width: 690px; }
  .fquote {
    margin-top: 702px; width: 276px;
    font-family: var(--serif); font-style: italic; font-weight: 300; font-size: 16px; line-height: normal;
    font-variation-settings: 'SOFT' 0, 'WONK' 1;
  }
  .copy { margin-top: 951px; white-space: pre; line-height: normal; }
  .season { margin-top: 962px; justify-self: end; line-height: normal; }

  @media (max-width: 1023.98px) {
    .footer { padding: 120px 20px calc(52vw + 120px); gap: 48px; }
    .wordmark { left: calc(50% - 48.1vw); top: auto; bottom: calc(24.8vw - 8px); font-size: 27.8vw; letter-spacing: -1.1vw; }
    .footer :global(.peaks) { left: 8.2%; top: auto; bottom: 7.4vw; width: 95.3%; height: auto; }
    .footer :global(.mountain) { left: -7.6%; top: auto; bottom: -12.2vw; width: 99.9%; height: auto; }
    .footer :global(.foreground) { left: -11.25%; top: auto; bottom: -17.8vw; width: 111.25%; height: auto; }
    .links { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 40px 20px; }
    .tagline { order: -1; }
    .fquote { max-width: 300px !important; }
    .copy, .season { position: absolute; bottom: 32px; margin: 0 !important; z-index: 2; }
    .copy { left: 20px; white-space: normal; }
    .season { right: 20px; }
  }
  @media (max-width: 599.98px) {
    .copy { bottom: 56px; }
    .season { left: 20px; right: auto; bottom: 28px; }
  }
</style>
