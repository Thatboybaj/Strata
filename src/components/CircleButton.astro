---
/** Circular outline button with the pixel arrow. lg = 250px, sm = 125px. */
import Arrow from '../assets/arrow-pixel.svg?raw';
interface Props { href?: string; size?: 'lg' | 'sm'; label: string; hoverText?: string; class?: string; [key: string]: unknown }
const { href, size = 'lg', label, hoverText, class: cls = '', ...rest } = Astro.props;
---
{href ? (
  <a href={href} class:list={['circle-btn', size, cls]} aria-label={label} {...rest}>
    <span class="arrow" set:html={Arrow} />
    {hoverText && <span class="hover-text" aria-hidden="true">{hoverText}</span>}
  </a>
) : (
  <button type="button" class:list={['circle-btn', size, cls]} aria-label={label} {...rest}>
    <span class="arrow" set:html={Arrow} />
    {hoverText && <span class="hover-text" aria-hidden="true">{hoverText}</span>}
  </button>
)}

<style>
  .circle-btn {
    position: relative;
    display: block;
    border-radius: 50%;
    border: 3px solid var(--white);
    overflow: hidden;
    color: var(--white);
    flex-shrink: 0;
  }
  .lg { width: 250px; height: 250px; }
  .sm { width: 125px; height: 125px; border-width: 1.5px; }
  .arrow {
    position: absolute;
    left: calc(50% + 0.55px);
    top: calc(50% + 0.55px);
    width: 204.904px;
    height: 204.904px;
    translate: -50% -50%;
  }
  .sm .arrow { width: 102.452px; height: 102.452px; left: calc(50% + 0.77px); top: calc(50% + 0.77px); }
  .arrow :global(svg) { width: 100%; height: 100%; }
  .hover-text {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    white-space: nowrap;
    color: #000;
    font-size: 16px;
    line-height: 1.3;
    opacity: 0;
  }
</style>
